    "@types/node": "^24",
    "@types/sinon": "^22.0.2",
    "dataloader": "^2.2.3",
    "eslint": "^10.15.0",
    "expect-type": "^1.4.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-dynalite": "^3.6.1",
    "sinon": "^22.1.0",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "dataloader": "^2.2.2",
    "zod": "^4.0.0"
